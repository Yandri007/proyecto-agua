NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TRUST_PROXY=1

DB_USER=postgres
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquacontrol
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Produccion administrada (reemplaza DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME)
# En Render usa el Session Pooler de Supabase, puerto 5432.
DATABASE_URL=
# Conexion directa recomendada exclusivamente para pg_dump y pg_restore.
DATABASE_DIRECT_URL=

JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

DEFAULT_EMPRESA_NAME=AquaControl Demo
DEFAULT_EMPRESA_SLUG=aqua-demo
ALLOWED_ORIGINS=

# Correo transaccional. auto prioriza Brevo y conserva Resend como respaldo.
EMAIL_PROVIDER=auto
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=AquaControl <notificaciones@tu-dominio.com>
EMAIL_REPLY_TO=

# Suscripciones recurrentes (Kushki Ecuador)
KUSHKI_ENVIRONMENT=uat
KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_PRIVATE_MERCHANT_ID=
KUSHKI_WEBHOOK_SIGNATURE=

# Operación y conservación
MONITORING_TOKEN=
LOCATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
PG_DUMP_PATH=
PG_RESTORE_PATH=
ALLOW_DATABASE_RESTORE=false
